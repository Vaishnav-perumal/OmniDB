# ==========================================
# OmniDB FastAPI Backend - Environment Configuration
# ==========================================

# Port to listen on (Render automatically supplies $PORT, defaults to 8000 locally)
PORT=8000

# Host to bind to (0.0.0.0 required for container/cloud deployment)
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated list, or * for all)
# Example: https://my-omnidb.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*

# Optional: set to "production" on Render
NODE_ENV=production
