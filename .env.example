# =====================================================================
# OmniDB Frontend - Environment Variables Configuration
# =====================================================================

# 1. FastAPI Backend API URL (Hosted on Render)
# Set this in your Vercel Project Settings -> Environment Variables.
# Example: https://omnidb-price-tracker.onrender.com
# Leave empty for local development to use the Vite local proxy (http://localhost:8000)
VITE_API_URL="https://omnidb-price-tracker.onrender.com"

# 2. Franchise Data Providers (Optional / Recommended)
# RAWG API Key for franchise catalog enrichment: https://rawg.io/apidocs
VITE_RAWG_API_KEY=""

# Twitch / IGDB API Credentials for IGDB catalog integration: https://api-docs.igdb.com/
VITE_TWITCH_CLIENT_ID=""
VITE_TWITCH_CLIENT_SECRET=""

# 3. Gemini AI API Key (Optional)
# Required only if using Google Gemini AI summary / studio capabilities
GEMINI_API_KEY=""
